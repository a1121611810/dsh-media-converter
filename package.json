{
  "name": "dsh-media-converter",
  "version": "1.0.1",
  "description": "Local media toolbox for DeepSeek Harness: convert, trim, split tracks, export subtitles, compress images, edit metadata, and Base64 — all through local ffmpeg.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "ffmpeg",
    "media",
    "converter",
    "transcode",
    "trim",
    "base64"
  ],
  "homepage": "https://github.com/a1121611810/dsh-media-converter",
  "bugs": {
    "url": "https://github.com/a1121611810/dsh-media-converter/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a1121611810/dsh-media-converter.git"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}

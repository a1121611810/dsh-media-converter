{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "plugins": ["typescript", "oxc", "unicorn", "import", "node", "vue"],
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": ["client.js", "client.js.map", "dist/**", ".agents/**"]
}
